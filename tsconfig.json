{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "expo-router/types"
    ]
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "nativewind-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}