{
  "name": "ashwi-app",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/services.test.cjs",
    "test:responsive": "node tests/responsive.cjs",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web --output-dir dist/web && node scripts/generate-seo-assets.cjs dist/web",
    "export:all": "expo export --platform all",
    "test:redesign": "node tests/redesign.cjs",
    "test:oauth": "node tests/oauth.cjs",
    "start": "expo start -c",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "android:build": "set \"GRADLE_USER_HOME=%TEMP%\\ashwi-gradle\" && cd android && .\\gradlew.bat assembleDebug",
    "android:install": "cd android && .\\gradlew.bat installDebug",
    "android:build:release": "set \"GRADLE_USER_HOME=%TEMP%\\ashwi-gradle\" && cd android && .\\gradlew.bat assembleRelease",
    "android:install:release": "%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe install -r android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "android:launch": "%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe shell monkey -p com.anonymous.ashwimobile -c android.intent.category.LAUNCHER 1",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-blur": "~14.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "nativewind": "4.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@react-native/gradle-plugin": "0.76.9",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.12",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3"
  }
}
