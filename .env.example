# Uses the Android emulator host on Android and localhost on iOS simulator/web.
EXPO_PUBLIC_API_PORT=5000
# For a physical phone, set your computer's LAN IP explicitly instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api
# For production, set this to the deployed backend origin plus /api.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
# Optional public site origin used for canonical URLs and the generated sitemap.
# EXPO_PUBLIC_SITE_URL=https://ashwi.example.com
